#!name=游民星空去广告
#!desc=V7 · 2026-11-04 · 开屏广告域名拦截与文末广告隐藏
#!category=去广告

[Rule]
DOMAIN-SUFFIX,adn-plus.com.cn,REJECT
DOMAIN-SUFFIX,fancydsp.com,REJECT
DOMAIN-SUFFIX,fancyapi.com,REJECT
DOMAIN,sdk.1rtb.net,REJECT
DOMAIN,t-dsp.pinduoduo.com,REJECT
