DOMAIN,ifs.tanx.com,REJECT

[Rewrite]
^https?://router\d*\.gamersky\.com/@/ad/getAdInPostPageBottom(?:/|\?|$) reject-dict
^https?:\/\/.+\.gamersky\.com\/v1\/statisticAd reject-dict
^https?:\/\/.+\.gamersky\.com\/.+\/adSystem\/ad\/.+ reject-dict
^https?://router\d*\.gamersky\.com/@/postPage/index/(?:[^?]+)(?:\?|$) response-body-json-jq 'if type=="object" then if (.post|type)=="object" and (.post.contentInHtml|type)=="string" then .post.contentInHtml |= (if contains("gs-stash-footer-ad") then . else . + "<style id=\"gs-stash-footer-ad\">.AdInPostPageBottom{display:none!important}</style>" end) else . end else . end'
^https?://(?:app\.gamersky\.com/template/[^/?]+\.html|m\.gamersky\.com/news/index\.html)(?:\?|$) response-body-replace-regex (?i)</head> <style>.AdInPostPageBottom{display:none!important}</style></head>

[MitM]
hostname = *.gamersky.com
