name: 游民星空去广告（加强版）
desc: 针对游民星空自有广告接口 + 常见第三方广告 SDK 的 Stash 覆写

rules:
  # 游民星空自有广告域名
  - DOMAIN,ja.gamersky.com,REJECT
  - DOMAIN,ja1.gamersky.com,REJECT
  - DOMAIN,ja2.gamersky.com,REJECT
  - DOMAIN,click.gamersky.com,REJECT

  # 优量汇 / 广点通
  - DOMAIN,sdk.e.qq.com,REJECT
  - DOMAIN,mi.gdt.qq.com,REJECT
  - DOMAIN,v2mi.gdt.qq.com,REJECT
  - DOMAIN,win.gdt.qq.com,REJECT
  - DOMAIN,adsmind.gdtimg.com,REJECT
  - DOMAIN,pgdt.ugdtimg.com,REJECT
  - DOMAIN,pgdt.gtimg.cn,REJECT

  # 穿山甲 / 巨量引擎
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
  - DOMAIN,log-api.pangolin-sdk-toutiao.com,REJECT
  - DOMAIN,log-api.pangolin-sdk-toutiao-b.com,REJECT
  - DOMAIN,sf3-fe-tos.pglstatp-toutiao.com,REJECT
  - DOMAIN,sf3-be-pack.pglstatp-toutiao.com,REJECT

  # 百度百青藤
  - DOMAIN,mobads.baidu.com,REJECT

  # 快手广告
  - DOMAIN,open.e.kuaishou.com,REJECT
  - DOMAIN,gdfp.gifshow.com,REJECT

  # 倍孜 / AdScope
  - DOMAIN,sdk.beizi.biz,REJECT
  - DOMAIN,api-htp.beizi.biz,REJECT
  - DOMAIN,api.htp.ad-scope.com.cn,REJECT

  # SigMob / ToBid
  - DOMAIN-SUFFIX,sigmob.cn,REJECT

  # InMobi
  - DOMAIN-SUFFIX,inmobi.com,REJECT
  - DOMAIN-SUFFIX,inmobi.cn,REJECT
  - DOMAIN-SUFFIX,inmobicdn.net,REJECT

  # Mintegral
  - DOMAIN-SUFFIX,rayjump.com,REJECT
  - DOMAIN-SUFFIX,mintegral.com,REJECT
  - DOMAIN-SUFFIX,mobvista.com,REJECT

http:
  mitm:
    - "*.gamersky.com"

  rewrite:
    - '^https?:\/\/.+\.gamersky\.com\/v1\/statisticAd - reject-dict'
    - '^https?:\/\/.+\.gamersky\.com\/.+\/adSystem\/ad\/.+ - reject-dict'
