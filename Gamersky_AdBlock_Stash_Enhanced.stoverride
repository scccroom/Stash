name: 游民星空去广告（加强版）
desc: 2026-11-04 v7：补充穿山甲、优量汇、Mintegral 和 Tanx 广告域名

rules:
  # 2026-11-03：按开屏复现时的 DNS 记录补充；规则对其他 App 的相同域名也生效
  # 倍孜 / 优加广告请求与追踪：ad-api、adx-track、ssp-track
  - DOMAIN-SUFFIX,adn-plus.com.cn,REJECT
  # 广告请求：aplus.fancydsp.com、ad-open2.fancydsp.com
  - DOMAIN-SUFFIX,fancydsp.com,REJECT
  # 广告 SDK：lftxali.fancyapi.com
  - DOMAIN-SUFFIX,fancyapi.com,REJECT
  # 广告 SDK 与拼多多 DSP；只阻断广告专用主机
  - DOMAIN,sdk.1rtb.net,REJECT
  - DOMAIN,t-dsp.pinduoduo.com,REJECT

  # ADmobile / 天目广告：补充旧版未覆盖的广告平台
  # 域名规则对其他使用该平台的 App 同样生效；不拦游民资讯图片/视频域名
  - DOMAIN-SUFFIX,admobile.top,REJECT

  # 游民星空自有广告域名
  - DOMAIN,ja.gamersky.com,REJECT
  - DOMAIN,ja1.gamersky.com,REJECT
  - DOMAIN,ja2.gamersky.com,REJECT
  - DOMAIN,click.gamersky.com,REJECT

  # 优量汇 / 广点通
  - DOMAIN,sdk.e.qq.com,REJECT
  - DOMAIN,mi.gdt.qq.com,REJECT
  - DOMAIN,v2mi.gdt.qq.com,REJECT
  - DOMAIN,win.gdt.qq.com,REJECT
  - DOMAIN,adsmind.gdtimg.com,REJECT
  - DOMAIN,adsmind.ugdtimg.com,REJECT
  - DOMAIN,pgdt.ugdtimg.com,REJECT
  - DOMAIN,pgdt.gtimg.cn,REJECT

  # 穿山甲 / 巨量引擎
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
  - DOMAIN,log-api.pangolin-sdk-toutiao.com,REJECT
  - DOMAIN,log-api.pangolin-sdk-toutiao-b.com,REJECT
  - DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
  - DOMAIN,api-access.pangolin-sdk-toutiao2.com,REJECT
  - DOMAIN,api-access.pangolin-sdk-toutiao3.com,REJECT
  - DOMAIN,api-access.pangolin-sdk-toutiao4.com,REJECT
  - DOMAIN,api-access.pangolin-sdk-toutiao5.com,REJECT
  - DOMAIN,sf3-fe-tos.pglstatp-toutiao.com,REJECT
  - DOMAIN,sf3-be-pack.pglstatp-toutiao.com,REJECT

  # 百度百青藤
  - DOMAIN,mobads.baidu.com,REJECT

  # 快手广告
  - DOMAIN,open.e.kuaishou.com,REJECT
  - DOMAIN,gdfp.gifshow.com,REJECT

  # 倍孜 / AdScope
  - DOMAIN,sdk.beizi.biz,REJECT
  - DOMAIN,api-htp.beizi.biz,REJECT
  - DOMAIN,api.htp.ad-scope.com.cn,REJECT

  # SigMob / ToBid
  - DOMAIN-SUFFIX,sigmob.cn,REJECT

  # InMobi
  - DOMAIN-SUFFIX,inmobi.com,REJECT
  - DOMAIN-SUFFIX,inmobi.cn,REJECT
  - DOMAIN-SUFFIX,inmobicdn.net,REJECT

  # Mintegral
  - DOMAIN-SUFFIX,rayjump.com,REJECT
  - DOMAIN-SUFFIX,mintegral.com,REJECT
  - DOMAIN-SUFFIX,mobvista.com,REJECT
  - DOMAIN-SUFFIX,mtgglobals.com,REJECT

  # 阿里妈妈 Tanx 广告请求
  - DOMAIN,ef-dongfeng.tanx.com,REJECT
  - DOMAIN,ifs.tanx.com,REJECT

http:
  mitm:
    - "*.gamersky.com"

  url-rewrite:
    # 文章底部自有广告：由当前官方模板中的取广告函数确认
    - '^https?://router\d*\.gamersky\.com/@/ad/getAdInPostPageBottom(?:/|\?|$) - reject-dict'
    - '^https?:\/\/.+\.gamersky\.com\/v1\/statisticAd - reject-dict'
    - '^https?:\/\/.+\.gamersky\.com\/.+\/adSystem\/ad\/.+ - reject-dict'

  # 仅隐藏官方模板里命名明确的文末广告组件，连同其标题、广告标识和关闭按钮
  # 仅追加广告样式，不删除文章正文、游戏卡片、评论或相关推荐
  body-rewrite:
    # 从文章正文数据注入样式，覆盖使用预置/缓存模板的页面；只追加样式，不删除正文或游戏卡片
    - '^https?://router\d*\.gamersky\.com/@/postPage/index/(?:[^?]+)(?:\?|$) response-jq if type=="object" then if (.post|type)=="object" and (.post.contentInHtml|type)=="string" then .post.contentInHtml |= (if contains("gs-stash-footer-ad") then . else . + "<style id=\"gs-stash-footer-ad\">.AdInPostPageBottom{display:none!important}</style>" end) else . end else . end'
    - '^https?://(?:app\.gamersky\.com/template/[^/?]+\.html|m\.gamersky\.com/news/index\.html)(?:\?|$) response-replace-regex (?i)</head> <style>.AdInPostPageBottom{display:none!important}</style></head>'


